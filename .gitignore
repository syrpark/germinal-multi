eval/
# Everything a run produces, including archives of earlier rounds, which live
# under results/_archive/<round>/<experiment>/. Archive inside results/ rather
# than as a sibling results_* directory, which this pattern would not catch.
results/
*.lock
tmp/
# Job scripts too: partition names, node exclusions and wall times are
# site-specific, so they are kept locally rather than shipped as examples.
jobs/
build/
outputs/
__pycache__/
.pytest_cache/

**/.DS_Store
*.pyc
*.csv
*.sh
*.gif
*.egg-info/
*.pt
*.out
params/*params_*

# Starting complexes generated by ensure_starting_complex_for_target
# (<target>_<cdr_lengths>_scfv.pdb); regenerated on each run.
pdbs/*_scfv.pdb

.cursorignore
audit-report.html

# Working notes are kept locally; the documentation below is shipped.
# docs/* rather than docs/, so the subtree can be re-included: git does not
# descend into an excluded DIRECTORY, so a negation under one never matches.
docs/*
# Pipeline documentation IS shipped: one file per stage, no run ids.
!docs/pipeline/
# Setup and configuration reference split out of the README.
!docs/af3-setup.md
!docs/shipped-configs.md

